# Supabase — see docs/supabase-infrastructure.md (LAN cashbook stack at 192.168.0.146:54321)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional + campaign email)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (quotes required if it includes a display name).
RESEND_FROM_EMAIL="The Georgette 150th <noreply@margies.app>"
# Optional: where to send alerts for new subscribers / talk registrations.
# Defaults to john@margies.app when unset.
REGISTRATION_ALERT_EMAIL=john@margies.app
# Optional: Bearer token for POST /api/admin/campaigns/process-scheduled
# (falls back to FULFILMENT_API_KEY). Also used with admin session cookie.
CRON_SECRET=

# App
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_EXHIBITION_NAME=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_URL=
# Master TIFFs (both Mac and server should mount the same NAS path).
# Mac example:    /Volumes/AppData/Exhibition/Masters
# Server example: /mnt/nas/AppData/Exhibition/Masters
MASTER_FILES_DIR=
MASTER_FILES_DIR_DEV=
# Shared folder for shop/site web images + video (both Mac and server should mount the same NAS path).
# Mac example:    /Volumes/AppData/Exhibition/web-media
# Server example: /mnt/nas/AppData/Exhibition/web-media
# Stores images/ and video/ under this directory. Falls back to public/ when unset.
WEB_MEDIA_DIR=
CHECKOUT_BYPASS_STRIPE=
# Temporary: when true, checkout/add-to-cart and private collections
# (/collections/request, vault unlock) only work for LAN Hosts
# (localhost, 127.0.0.1, 192.168.x.x, 10.x, etc). Public exhibition.margies.app is blocked.
PURCHASES_LAN_ONLY=
EXHIBITION_API_BASE_URL=

# Square Point of Sale (on-site card reader). Application ID from Square Developer Console.
# Allowlist callback: {NEXT_PUBLIC_SITE_URL}/admin/on-site/square-return
SQUARE_APPLICATION_ID=
PRINT_OUTPUT_PROFILE_PATH=
# Required for the fulfilment worker — print TIFFs are written here.
# Mac example:    /Volumes/AppData/Exhibition/print-output
# Server example: /mnt/nas/AppData/Exhibition/print-output
LOCAL_OUTPUT_DIR=
# Optional: create a per-order folder and upload the TIFF using personal Drive OAuth.
GOOGLE_OAUTH_TOKEN_PATH=
GOOGLE_DRIVE_FOLDER_ID=
# Alternative for Shared Drives only; service accounts have no personal Drive quota.
GOOGLE_APPLICATION_CREDENTIALS=

# Admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional; falls back to ADMIN_SESSION_SECRET for private-collection access cookies
VAULT_SESSION_SECRET=

# External API auth
EXHIBITION_API_KEY=
